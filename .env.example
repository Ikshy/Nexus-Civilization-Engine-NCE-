# Nexus Civilization Engine - Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://nce:nce_password@postgres:5432/nexus_db
DATABASE_SYNC_URL=postgresql://nce:nce_password@postgres:5432/nexus_db

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_secret_key_in_production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Simulation defaults
WORLD_SIZE_X=50
WORLD_SIZE_Y=50
AGENT_COUNT=200
TICK_RATE=5
SIMULATION_SEED=42
MAX_TICKS=10000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
